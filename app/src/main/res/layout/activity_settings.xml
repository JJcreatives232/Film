<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0B0B0B" android:padding="22dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Settings" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Private router movie library" android:textColor="#888888"
            android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="FTP USERNAME" android:textColor="#777777" android:textSize="12sp"
            android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="root" android:textColor="#FFFFFF" android:textSize="17sp"
            android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="ROUTER" android:textColor="#777777" android:textSize="12sp"
            android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="192.168.100.1 : 21" android:textColor="#FFFFFF" android:textSize="17sp"
            android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="MOVIE FOLDER" android:textColor="#777777" android:textSize="12sp"
            android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="/Movies/" android:textColor="#FFFFFF" android:textSize="17sp"
            android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/reconfigureButton" android:text="CHANGE FTP PASSWORD"
            android:layout_marginTop="30dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/profilesButton" android:text="MANAGE PROFILES"
            android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
