<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0B0B0B" android:orientation="vertical" android:padding="18dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="JUNO" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/profileButton" android:text="Profile" android:textColor="#D7B45A"
            android:textSize="14sp" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/settingsButton" android:text="⚙" android:textColor="#FFFFFF"
            android:textSize="22sp" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/welcomeText" android:textColor="#A7A7A7" android:textSize="14sp"
        android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/searchBox" android:hint="Search your movies..."
        android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#777777"
        android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="50dp"/>
    <TextView android:id="@+id/statusText" android:text="Connecting..."
        android:textColor="#888888" android:layout_marginTop="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/movieList"
        android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
