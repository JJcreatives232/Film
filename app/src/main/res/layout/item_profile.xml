<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_card" android:gravity="center_vertical" android:padding="14dp"
    android:layout_marginBottom="10dp" android:orientation="horizontal"
    android:layout_width="match_parent" android:layout_height="72dp">
    <TextView android:id="@+id/avatar" android:text="J" android:gravity="center"
        android:textColor="#0B0B0B" android:textStyle="bold" android:textSize="22sp"
        android:background="#D7B45A" android:layout_width="48dp" android:layout_height="48dp"/>
    <TextView android:id="@+id/profileName" android:textColor="#FFFFFF" android:textSize="18sp"
        android:layout_marginStart="15dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
</LinearLayout>
