<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#0B0B0B" android:orientation="vertical" android:padding="22dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Who's watching?" android:textColor="#FFFFFF" android:textSize="28sp"
        android:textStyle="bold" android:layout_marginTop="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Choose a profile or create a new one" android:textColor="#888888"
        android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/profileList"
        android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/addProfileButton" android:text="+  ADD PROFILE"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
