<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_card" android:gravity="center_vertical" android:padding="12dp"
    android:layout_marginBottom="9dp" android:orientation="horizontal"
    android:layout_width="match_parent" android:layout_height="78dp">
    <TextView android:id="@+id/movieIcon" android:text="▶" android:gravity="center"
        android:textColor="#0B0B0B" android:textSize="18sp" android:background="#D7B45A"
        android:layout_width="50dp" android:layout_height="50dp"/>
    <LinearLayout android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="13dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
        <TextView android:id="@+id/movieTitle" android:textColor="#FFFFFF" android:textSize="16sp"
            android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/moviePath" android:textColor="#777777" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/favoriteIcon" android:text="♡" android:textColor="#FFFFFF"
        android:textSize="25sp" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
